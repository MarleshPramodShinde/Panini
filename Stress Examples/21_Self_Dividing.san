// 42: Self-Dividing Numbers (e.g. 128 is divisible by 1, 2, and 8)
वद "Checking number 128:"
१२८ संख्या-मध्ये स्थापय
संख्या वर्तमान-मध्ये स्थापय
१ सफल-मध्ये स्थापय

यावत् ( वर्तमान > ० ) {
    वर्तमान १० विभज भाग-मध्ये
    भाग १० गुणय गुणन-मध्ये
    वर्तमान गुणन न्यूनय शेष-मध्ये
    
    यदि ( शेष == ० ) {
        ० सफल-मध्ये स्थापय
    } तर्हि {
        संख्या शेष विभज जांच_भाग-मध्ये
        जांच_भाग शेष गुणय जांच_गुणन-मध्ये
        यदि ( संख्या != जांच_गुणन ) {
            ० सफल-मध्ये स्थापय
        }
    }
    भाग वर्तमान-मध्ये स्थापय
}

यदि ( सफल == १ ) { वद संख्या " is Self-Dividing!" }
तर्हि { वद संख्या " is NOT Self-Dividing." }