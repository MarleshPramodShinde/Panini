// 31: Pythagorean Triplets (A^2 + B^2 = C^2)
वद "Finding triplets up to limit 15..."
१५ सीमा-मध्ये स्थापय
१ अ-मध्ये स्थापय

यावत् ( अ <= सीमा ) {
    अ अ गुणय अ_वर्ग-मध्ये
    १ ब-मध्ये स्थापय
    
    यावत् ( ब <= सीमा ) {
        ब ब गुणय ब_वर्ग-मध्ये
        १ स-मध्ये स्थापय
        
        यावत् ( स <= सीमा ) {
            स स गुणय स_वर्ग-मध्ये
            अ_वर्ग ब_वर्ग संयोजय योग-मध्ये
            
            यदि ( योग == स_वर्ग ) {
                वद "Triplet found: " अ ", " ब ", " स
            }
            स १ संयोजय स-मध्ये
        }
        ब १ संयोजय ब-मध्ये
    }
    अ १ संयोजय अ-मध्ये
}